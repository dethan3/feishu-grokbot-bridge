# /etc/feishu-grokbot-bridge.env  (install.sh writes this; chmod 600). NEVER commit real values.
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
# Owner open_id(s), comma-separated. Owners are forwarded everywhere (p2p + groups).
FEISHU_OWNER_OPEN_IDS=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# This bot's own open_id: skip its own messages; guests are forwarded only in groups when they @bot or @all.
FEISHU_BOT_OPEN_ID=ou_yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
FEISHU_WEBHOOK_URL=https://example.com/your-grokbot-webhook-url
FEISHU_WEBHOOK_KEY=replace-me
BRIDGE_WORK_DIR=/var/lib/feishu-grokbot-bridge
LARKSUITE_CLI_CONFIG_DIR=/var/lib/feishu-grokbot-bridge/lark-cli
LARK_CLI=/usr/local/bin/lark-cli
# Optional
#FEISHU_SEED_CHATS=oc_xxx,oc_yyy     # chats to poll from the start (others are learned automatically)
#POLL_EVERY=90  POLL_WINDOW=300  STALE_SEC=900  RETRY_EVERY=60  SEEN_MAX=5000
#WATCHDOG_QUIET_AFTER_DISCONNECT=60  # restart if SDK logged a disconnect and the bus stayed silent this long
#WATCHDOG_SILENCE_MAX=0              # >0: also restart after this many seconds of total bus silence
#BRIDGE_LOG_FILE=                    # empty = stdout (journald)
