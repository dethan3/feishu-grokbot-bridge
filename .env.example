# Copy to .env (or one file per bot, e.g. bots/mybot.env) and fill in. NEVER commit real values.
# Comma-separated open_ids allowed to talk to Grok Bot through this bridge (ou_...).
FEISHU_OWNER_OPEN_IDS=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# This bot's own open_id, used to detect @bot in groups. Empty => groups only forward @all.
FEISHU_BOT_OPEN_ID=ou_yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
# Grok Bot webhook routine URL and its bearer key.
FEISHU_WEBHOOK_URL=https://example.com/your-grokbot-webhook-url
FEISHU_WEBHOOK_KEY=replace-me
# Instance dir for state/queues/logs (relative to repo root). Use a distinct dir per bot.
BRIDGE_WORK_DIR=run/default
# Optional
#LARK_CLI=lark-cli
#LARK_CLI_EXTRA_ARGS=          # extra global args, e.g. to select a per-bot lark-cli profile/config
#RETRY_EVERY=60
#SEEN_MAX=5000
#WATCHDOG_CHECK_EVERY=60
#WATCHDOG_RECONNECT_EVERY=1800
